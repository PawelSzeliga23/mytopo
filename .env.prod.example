# Serwer: skopiuj do .env (cp .env.prod.example .env) i uzupełnij. Nie kopiuj lokalnego .env.
# Adres strony (https:// włącza bezpieczne ciasteczko logowania)
PUBLIC_URL=https://topo.twojadomena.pl
# Hasło edycji dla znajomych: długie, np. 4–5 losowych słów
EDIT_PASSWORD=
# Klucz podpisu ciasteczka: openssl rand -hex 32
SECRET_KEY=
# Hasło bazy (baza nie jest wystawiona na zewnątrz): openssl rand -hex 16
DB_PASSWORD=
# Port dla nginx na hoście; gdy nginx działa w kontenerze, ustaw np. 8090 (wszystkie interfejsy)
TOPO_PORT=127.0.0.1:8090
